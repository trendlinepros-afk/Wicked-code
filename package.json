{
  "name": "wicked-code",
  "productName": "Wicked Code",
  "version": "0.8.0",
  "description": "A local-first Claude Code style desktop app for chat and coding, powered by Ollama with optional Gemini, Anthropic, DeepSeek and Grok APIs.",
  "main": "electron/main.cjs",
  "author": "Wicked Code",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --test electron/*.test.cjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.wicked.code",
    "productName": "Wicked Code",
    "files": [
      "dist/**",
      "electron/**",
      "!electron/*.test.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Wicked-Code-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Wicked-Code-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "Wicked-Code-linux-${arch}.${ext}",
      "category": "Development"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "trendlinepros-afk",
        "repo": "Wicked-code",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Wicked Code"
    }
  },
  "dependencies": {
    "docx": "^9.8.1",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trendlinepros-afk/Wicked-code.git"
  },
  "homepage": "https://github.com/trendlinepros-afk/Wicked-code"
}
